import re

import pandas as pd
from pathlib import Path

REPO_ROOT = Path(workflow.basedir).parent

# Image digests live in their own file; Snakemake has no !include, so load it as a second configfile.
configfile: str(REPO_ROOT / 'config/images.yaml')

# Every image must be a docker:// URI pinned by digest. Without the scheme Snakemake treats the
# string as a local image path and the job dies at start (M02 job 7851561), so fail at parse time.
_IMAGE_URI = re.compile(r'^docker://[^\s@]+@sha256:[0-9a-f]{64}$')
_bad_images = {k: v for k, v in (config.get('images') or {}).items() if not _IMAGE_URI.match(str(v))}
if _bad_images:
    raise ValueError(f'config/images.yaml: each image must be docker://<registry>/<name>@sha256:<64 hex>, not {_bad_images}')

workdir: config['workdir']
include: 'scripts/utils.py'

# Without a ticket, run_id() is the RUN_ID_UNSET placeholder, so --list, --unlock and the like still
# parse. With offload on, a real run under it stops here, before any job reaches Tier 2. Snakemake
# skips onstart for dry runs, --list and --unlock.
onstart:
    refuse_unset_run_id()

# Absolutize relative reference paths up front. On the cluster these no-op;
# under config.local.yaml they become repo-rooted so the local fixture resolves.
def _absolutize_reference_paths():
    for key in list(config.get('reference', {})):
        val = config['reference'].get(key)
        if isinstance(val, str) and not val.startswith('/'):
            config['reference'][key] = str(REPO_ROOT / val)

_absolutize_reference_paths()

# One row per assembly under evaluation; `subject` is the Tier 2 folder (e.g. ROS_Cfam_2.0).
samples_df = pd.read_csv(REPO_ROOT / config['samples'], sep='\t', dtype=str)
ASSEMBLIES = samples_df['assembly'].tolist()
SUBJECT    = dict(zip(samples_df['assembly'], samples_df['subject']))

wildcard_constraints:
    assembly = r'[^/]+',
    subject  = r'[^/]+'

# Lane rule files: workflow/rules/<lane>/<metric>.smk, in each lane's own folder.
# include: 'rules/jc/assembly_stats.smk'
include: 'rules/sf/telomeres.smk'

# Each enabled metric's target rule. Tickets name a lane target, never `all`: the run-id is per ticket.
rule all:
    default_target: True
    input:
        rules.sf_telomeres_all.input
