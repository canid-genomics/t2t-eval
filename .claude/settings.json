{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(wg:*)",
      "Bash(pixi run snakemake -n:*)",
      "Bash(pixi run snakemake --lint:*)",
      "Bash(python3 scripts/spec2wg.py:*)",
      "Bash(scripts/triage/parse_submit_log.py:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(sbatch slurm/submit.slurm --ticket tickets/sf/*)"
    ],
    "ask": [
      "Bash(scancel:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean -f:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(sbatch slurm/submit.slurm --ticket tickets/jc/*)",
      "Bash(sbatch slurm/submit.slurm --ticket tickets/shared/*)",
      "Bash(sbatch -*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(sbatch *)",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/sbatch_guard.py\""
          }
        ]
      }
    ]
  }
}
